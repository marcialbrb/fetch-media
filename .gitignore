# compiled output
/frontend/dist
/ui/dist
/ui/exported/CHANGELOG.json
/webext/ytptube-extension.zip

# dependencies
**/node_modules/*
**/.nuxt/*

# IDEs and editors
/ui/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
.history/*

# Keep Var dir
var/*
!./var/config/.gitkeep
!./var/downloads/.gitkeep
!./var/tmp/.gitkeep

# Misc - python stuff
__pycache__
.venv
.idea
dist
build
version.txt
test_impl.py
./eslint.config.js
.pytest_cache

# ---------------------------------------------------------------------------
# Fetch Media - local runtime data. None of this belongs in a public repo.
# ---------------------------------------------------------------------------

# Instance state: settings database, logs and the archive. The logs record every
# URL you download and the database holds your history and credentials hashes.
/config/*
!/config/.gitkeep

# Downloaded media: private and large (this folder is routinely hundreds of MB).
/downloads/*
!/downloads/.gitkeep
!/downloads/files/.gitkeep
!/downloads/tmp/.gitkeep

# Local development scaffolding (mock API, reference screenshots).
/.dev-mock

# Brand source material: the runtime copies live in ui/public/images/, so the
# working files do not need to ship. hero/public/ is the exception — those are
# the screenshots linked from README.md, so that folder is re-included.
/hero/*
!/hero/public/

# Secrets and local environment. `docker compose` reads ./.env, so keep it out of
# the repo; commit a .env.example instead.
.env
.env.*
!.env.example
cookies.txt
*.session
*.netrc
