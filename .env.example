# Copy to .env (gitignored) and adjust per host: cp .env.example .env
# Note: this file belongs to compose (repo root), it is not the UI env.example (NUXT_*).

TZ=America/Argentina/Buenos_Aires
UID=1000
GID=1000

# Host port where YTPTube is published (the container's internal port is always 8081).
# After cleaning up Cobalt this can be changed to 80 to reach it without a port.
HOST_PORT=8081

YTP_MAX_WORKERS=1
YTP_MAX_WORKERS_PER_EXTRACTOR=1
YTP_REMOVE_FILES=true