# Copiar a .env (gitignored) y ajustar a cada host: cp .env.example .env
# Ojo: este archivo es del compose (raíz del repo), distinto del env.example del UI (NUXT_*).

TZ=America/Argentina/Buenos_Aires
UID=1000
GID=1000

# Puerto del host donde se publica YTPTube (el interno del contenedor es siempre 8081).
# Después de limpiar Cobalt se puede cambiar a 80 para entrar sin puerto.
HOST_PORT=8081
