{
  "short_name": "Fetch Media",
  "name": "Fetch Media",
  "description": "A self-hosted download manager, automation interface, and media library preparation layer for yt-dlp.",
  "start_url": "/",
  "share_target": {
    "action": "./?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "background_color": "#2B2624",
  "theme_color": "#2B2624",
  "orientation": "any",
  "categories": [
    "downloaders",
    "video",
    "audio"
  ],
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "32x32",
      "type": "image/x-icon"
    },
    {
      "src": "images/favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "images/logo.png",
      "sizes": "800x600",
      "type": "image/png"
    }
  ]
}
